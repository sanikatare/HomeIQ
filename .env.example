# ==============================================================================
# HomeIQ — AI Household Intelligence & Management Platform
# Clean Environment Configuration Template (.env.example)
# Copy to `.env` for local development: `cp .env.example .env`
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SECRETS (Provide manually for live Gemini AI or production deployment)
# ------------------------------------------------------------------------------
# Single Google Gemini API key used across Gemini 2.5 Flash, Pro, and Embeddings.
# Leave blank to run in deterministic offline/evaluation fallback mode.
GEMINI_API_KEY=

# HMAC-SHA256 signing secret for bearer tokens (override in production)
JWT_SECRET_KEY=dev-only-jwt-secret-replace-Via-secret-manager-in-prod-32b

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Sensible localhost defaults provided)
# ------------------------------------------------------------------------------
POSTGRES_USER=homeiq
POSTGRES_PASSWORD=homeiq_local_dev_pw
POSTGRES_DB=homeiq_core
DATABASE_URL=postgresql+asyncpg://homeiq:homeiq_local_dev_pw@localhost:5432/homeiq_core

# ------------------------------------------------------------------------------
# 3. OPTIONAL RUNTIME & MODEL CONFIGURATION (Safe defaults built into code)
# ------------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DOCUMENT_STORAGE_DIR=/tmp/homeiq_document_vault

# Gemini Model Identifiers (Configuration values, NOT secrets)
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Grounded Retrieval & Safety Thresholds
RAG_TOP_K_CHUNKS=5
RAG_MIN_SIMILARITY_SCORE=0.72
REQUIRE_HUMAN_APPROVAL_FOR_CONSEQUENTIAL_TOOLS=true
