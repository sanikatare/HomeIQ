# ==============================================================================
# HomeIQ — Environment Configuration (.env.example)
# Only 3 optional variables. All have safe local defaults so the app runs
# out-of-the-box with zero configuration.
# ==============================================================================

# 1. Google Gemini API Key (Leave blank for offline deterministic mode; add later for live Gemini)
GEMINI_API_KEY=

# 2. Database Connection URL (Defaults to local PostgreSQL / local state store)
DATABASE_URL=postgresql+asyncpg://homeiq:homeiq_local_dev_pw@localhost:5432/homeiq_core

# 3. Token Signing Secret (Defaults to local development secret)
JWT_SECRET_KEY=dev-only-jwt-secret-replace-Via-secret-manager-in-prod-32b
